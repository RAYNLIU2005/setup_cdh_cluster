# CDH集群部署系统环境配置模板
# author: RaynLiu
# email: liuyu1_j6go@stu.cqie.edu.cn
# date: 2025-11-12
# 使用说明：复制此文件为 .env 并填写实际配置

# ==========================================
# 项目基本配置
# ==========================================
PROJECT_NAME=setup_cdh_cluster
PROJECT_DIR=/root/setup_cdh_cluster
AUTHOR_NAME=RaynLiu
AUTHOR_EMAIL=liuyu1_j6go@stu.cqie.edu.cn

# ==========================================
# 集群节点配置
# ==========================================
MASTER_NODE=node01
MASTER_IP=192.168.56.151

SLAVE_NODE_1=node02
SLAVE_IP_1=192.168.56.152

SLAVE_NODE_2=node03
SLAVE_IP_2=192.168.56.153

# SSH 配置
SSH_USER=root
SSH_PASSWORD=123456

# ==========================================
# MySQL配置
# ==========================================
MYSQL_ROOT_PASSWORD=Cloudera!20200801
MYSQL_HOST=localhost
MYSQL_PORT=3306

# CDH数据库密码
DB_PASSWORD_SCM=SuperMan2020#h
DB_PASSWORD_AMON=SuperMan2020#h
DB_PASSWORD_RMAN=SuperMan2020#h
DB_PASSWORD_HIVE=SuperMan2020#h
DB_PASSWORD_SENTRY=SuperMan2020#h
DB_PASSWORD_NAV=SuperMan2020#h
DB_PASSWORD_NAVMS=SuperMan2020#h
DB_PASSWORD_OOZIE=SuperMan2020#h
DB_PASSWORD_HUE=SuperMan2020#h

# ==========================================
# CDH版本配置
# ==========================================
CDH_VERSION=6.2.0
CM_VERSION=6.2.0
JAVA_VERSION=8u261
SCALA_VERSION=2.13.0-M4
MYSQL_VERSION=5.7.30

# ==========================================
# 安装路径配置
# ==========================================
BASE_FILE_PATH=/opt/base_file
PACKAGE_PATH=/opt/setup_cdh
INSTALL_PATH=/usr/local

# ==========================================
# 网络配置
# ==========================================
YUM_REPO_HOST=node01
YUM_REPO_PORT=80

# Cloudera官方源（备用）
CLOUDERA_BASE_URL=https://archive.cloudera.com/cm6/6.3.1/redhat7/yum/

# ==========================================
# 日志配置
# ==========================================
LOG_FILE=/var/log/cdh_deploy.log
LOG_LEVEL=INFO
LOG_MAX_SIZE=100M
LOG_BACKUP_COUNT=5

# ==========================================
# 部署配置
# ==========================================
DEPLOY_TIMEOUT=3600
CHECK_INTERVAL=30
RETRY_COUNT=3

# 是否启用自动清理
AUTO_CLEANUP=true

# 是否启用磁盘空间检查
DISK_CHECK_ENABLED=true
MIN_DISK_SPACE_GB=25

# ==========================================
# 服务端口配置
# ==========================================
CM_SERVER_PORT=7180
CM_AGENT_PORT=7182
MYSQL_PORT=3306
HTTPD_PORT=80

# ==========================================
# Docker配置（可选）
# ==========================================
DOCKER_REGISTRY=
DOCKER_IMAGE_TAG=latest
ENABLE_DOCKER=false

# ==========================================
# 备份配置
# ==========================================
BACKUP_PATH=/opt/backup
BACKUP_RETENTION_DAYS=7
AUTO_BACKUP=false
